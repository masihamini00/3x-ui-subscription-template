server {
    listen __PUBLIC_PORT____PUBLIC_SSL__;
    listen [::]:__PUBLIC_PORT____PUBLIC_SSL__;
    server_name __SERVER_NAME__;

__TLS_DIRECTIVES__
    server_tokens off;
    access_log off;
    error_log /var/log/nginx/3x-ui-subscription-dashboard-error.log warn;
    client_max_body_size 1m;

    location ^~ /v1/history/ {
        proxy_http_version 1.1;
        proxy_pass __HISTORY_UPSTREAM__;
        proxy_ssl_verify off;
        proxy_set_header Host __UPSTREAM_HOST__;
        proxy_set_header Accept "application/json";
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
        proxy_buffering off;
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_redirect off;
        proxy_pass __SUB_UPSTREAM__;
        proxy_ssl_verify off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffer_size 64k;
        proxy_buffers 16 64k;
    }
}
